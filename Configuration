Creating ACL on router:
Office_Router#conf t
Enter configuration commands, one per line.  End with CNTL/Z.
Office_Router(config)#ip access-list extended Guest-RESTRICTION
Office_Router(config-ext-nacl)#deny ip 192.168.30.0 0.0.0.255 192.168.10.0 0.0.0.255
Office_Router(config-ext-nacl)#deny ip 192.168.30.0 0.0.0.255 192.168.20.0 0.0.0.255
Office_Router(config-ext-nacl)#permit ip 192.168.30.0 0.0.0.255 any
Office_Router(config-ext-nacl)#exit

Office_Router(config)#interface gig0/0.30
Office_Router(config-subif)#ip access-group Guest-RESTRICTION in
Office_Router(config-subif)#exit
Office_Router(config)#end
Office_Router#copy running-config startup-config
